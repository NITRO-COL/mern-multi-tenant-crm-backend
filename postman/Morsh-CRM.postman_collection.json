                "key": "Authorization",
                "value": "Bearer {{acmeAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leads?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leads"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('paginated envelope', () => pm.expect(body.meta).to.have.property('totalPages'));",
                  "pm.test('page is not the whole collection', () => pm.expect(body.data.length).to.be.at.most(10));",
                  "if (body.data.length) pm.collectionVariables.set('acmeLeadId', body.data[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List \u2014 search + status filter + sort",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{acmeAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leads?page=1&limit=10&search=a&status=QUALIFIED&sortBy=name&sortOrder=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leads"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "a"
                },
                {
                  "key": "status",
                  "value": "QUALIFIED"
                },
                {
                  "key": "sortBy",
                  "value": "name"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('every row matches the status filter', () =>",
                  "  body.data.forEach(l => pm.expect(l.status).to.eql('QUALIFIED')));"
                ]
              }
            }
          ]
        },
